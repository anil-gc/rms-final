# Copy to .env; set secrets locally. Never commit .env.
# For production, select the settings module in the PROCESS environment.
DJANGO_SECRET_KEY=
# Generate separately with secrets.token_urlsafe(48); never reuse DJANGO_SECRET_KEY.
DJANGO_PIN_PEPPER=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Use a NEW database and role; never point this rebuild at the prototype database.
DB_NAME=rms_development
DB_USER=rms_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
# Production defaults to require; use verify-full with a trusted certificate.
DB_SSLMODE=prefer

# Browser origins, including scheme and port, without trailing slashes.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Enable only for an explicit browser origin when using cookies across origins.
DJANGO_CORS_ALLOW_CREDENTIALS=False
DJANGO_LOG_LEVEL=INFO

# Production: supply a separate environment, explicitly set real hostnames,
# choose DB_SSLMODE=require or verify-full, and generate a separate secret.
# Process environment: DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=api.your-domain.example
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example
# DJANGO_BEHIND_HTTPS_PROXY=False
# Set True ONLY behind a trusted proxy that strips client-supplied
# X-Forwarded-Proto and sets it from the original HTTPS connection.
